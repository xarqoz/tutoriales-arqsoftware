# Copie este archivo a .env y ajuste los valores si lo necesita.
# docker-compose.yml ya define estas variables para el entorno local;
# este archivo sirve de referencia / para ejecución fuera de Docker.

DB_NAME=tienda_db
DB_USER=postgres
DB_PASSWORD=secret_password
DB_HOST=localhost        # en Docker: db
DB_PORT=5432

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
